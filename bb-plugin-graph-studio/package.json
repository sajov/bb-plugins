{
  "name": "bb-plugin-graph-studio",
  "version": "0.1.3",
  "description": "Build agent graphs that may contain cycles, run them, and watch them live. Nodes are BB threads.",
  "author": "sajov",
  "repository": {
    "type": "git",
    "url": "https://github.com/sajov/bb-plugins.git",
    "directory": "bb-plugin-graph-studio"
  },
  "keywords": [
    "bb-plugin",
    "agents",
    "graph",
    "langgraph",
    "orchestration",
    "workflow"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Graph Studio",
    "description": "Build agent graphs that may contain cycles, run them, and watch them live. Nodes are BB threads; LangGraph holds state, edges, cycles and checkpoints.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
