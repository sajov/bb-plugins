{
  "name": "bb-plugin-canvas",
  "version": "0.1.0",
  "description": "Every BB thread as one navigable tree: Agents, projects, threads.",
  "author": "sajov",
  "repository": {
    "type": "git",
    "url": "https://github.com/sajov/bb-plugins.git",
    "directory": "bb-plugin-canvas"
  },
  "keywords": [
    "bb-plugin",
    "canvas",
    "threads",
    "agents"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.6.15"
